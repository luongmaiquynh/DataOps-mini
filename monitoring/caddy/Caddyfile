# Tắt HTTP/3: Caddy nghe QUIC trên UDP 443 và quảng cáo `alt-svc: h3`, nhưng
# compose chỉ publish TCP 443 nên gói UDP không bao giờ tới nơi. Trình duyệt
# nhớ lời mời đó 30 ngày rồi treo ở mỗi lần vào sau; curl không dính vì không
# dùng HTTP/3. Lab không cần HTTP/3 nên tắt, thay vì mở thêm một cổng nữa.
{
	servers {
		protocols h1 h2
	}
}

# Reverse proxy đặt trước mọi giao diện web của VM1.
# Định tuyến theo tên miền nên tất cả dùng chung cổng 443, URL không có số cổng.
#
# Đuôi .test được RFC 6761 dành riêng cho môi trường thử nghiệm nên không bao
# giờ đụng tên miền thật. Không dùng .local vì macOS dành nó cho mDNS.
#
# `tls internal` dùng CA nội bộ do Caddy tự sinh và tự gia hạn. Trình duyệt sẽ
# cảnh báo vì không biết CA này — đã chấp nhận cho môi trường lab.
#
# Máy muốn truy cập phải trỏ các tên này về 192.168.64.2 trong /etc/hosts.

(common) {
	tls internal
	# Xoá lời mời h3 mà trình duyệt đã nhớ từ trước. Bỏ dòng này được sau khi
	# mọi máy từng truy cập đã nạp lại ít nhất một lần.
	header Alt-Svc "clear"
	encode gzip
	header -Server
}

grafana.dataops.test {
	import common
	reverse_proxy grafana:3000
}

airflow.dataops.test {
	import common
	reverse_proxy airflow_webserver:8080
}

prometheus.dataops.test {
	import common
	reverse_proxy prometheus:9090
}

alerts.dataops.test {
	import common
	reverse_proxy alertmanager:9093
}

flower.dataops.test {
	import common
	reverse_proxy airflow_flower:5555
}

cadvisor.dataops.test {
	import common
	reverse_proxy cadvisor:8080
}
