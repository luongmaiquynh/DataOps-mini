# File này do Ansible sinh ra từ roles/dotenv/templates/env.j2
# KHÔNG sửa trực tiếp trên VM — sửa group_vars rồi chạy lại playbook.
# Nguồn: infra/ansible/group_vars/all/{vars.yml,vault.yml}

# --- Database (VM2) ---
POSTGRES_USER={{ env_postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DB={{ env_postgres_db }}
POSTGRES_HOST={{ env_postgres_host }}
POSTGRES_PORT={{ env_postgres_port }}

# --- Redis (VM2) ---
REDIS_HOST={{ env_redis_host }}
REDIS_PORT={{ env_redis_port }}

# --- Object storage (VM2) ---
MINIO_ROOT_USER={{ vault_minio_root_user }}
MINIO_ROOT_PASSWORD={{ vault_minio_root_password }}
MINIO_HOST={{ env_minio_host }}
MINIO_PORT={{ env_minio_port }}
MINIO_CONSOLE_PORT={{ env_minio_console_port }}
MINIO_BUCKET={{ env_minio_bucket }}

{% if inventory_hostname == 'vm1' %}
# --- Airflow (chỉ VM1 cần) ---
AIRFLOW__CORE__FERNET_KEY={{ vault_airflow__core__fernet_key }}
AIRFLOW__WEBSERVER__SECRET_KEY={{ vault_airflow__webserver__secret_key }}
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN={{ vault_airflow__database__sql_alchemy_conn }}
AIRFLOW__CELERY__BROKER_URL={{ vault_airflow__celery__broker_url }}
AIRFLOW__CELERY__RESULT_BACKEND={{ vault_airflow__celery__result_backend }}

# --- Grafana (chỉ VM1 cần) ---
GRAFANA_ADMIN_USER={{ env_grafana_admin_user }}
GRAFANA_ADMIN_PASSWORD={{ vault_grafana_admin_password }}
{% endif %}
