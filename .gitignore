# Các file môi trường và mật khẩu
.env
.env.local
# bản backup .env do Ansible tạo trên VM
.env.*

# Thư mục rác của Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Nhật ký và dữ liệu nặng
*.log
*.csv
*.json
*.xlsx
!sample_data/sample.csv
!pipeline/tests/fixtures/*.csv
# Dashboard và datasource Grafana là mã nguồn, không phải dữ liệu
!monitoring/grafana/**/*.json

# Thư mục runtime của Airflow (được mount vào container)
logs/
plugins/

# File hệ thống Mac
.DS_Store

# Thư mục IDE
.vscode/
.idea/
