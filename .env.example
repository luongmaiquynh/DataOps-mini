# Mẫu cấu hình. Trên hệ thống thật, file .env do Ansible sinh ra từ
# infra/ansible/roles/dotenv/templates/env.j2 với secret lấy từ vault.
#
# --- THÔNG TIN DATABASE & CACHE (Đặt tại VM2: 192.168.64.3) ---
POSTGRES_USER=dataops
POSTGRES_PASSWORD=<sinh bang: openssl rand -hex 20>
POSTGRES_DB=dataops_db
POSTGRES_HOST=192.168.64.3
POSTGRES_PORT=5432

REDIS_HOST=192.168.64.3
REDIS_PORT=6379

# --- THÔNG TIN LƯU TRỮ OBJECT STORAGE (Đặt tại VM2: 192.168.64.3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<sinh bang: openssl rand -hex 20>
MINIO_HOST=192.168.64.3
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=dataops-lake

# --- CẤU HÌNH AIRFLOW (Chạy chính tại VM1: 192.168.64.2) ---
# Dùng lệnh này để tạo Fernet Key: openssl rand -base64 32
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
AIRFLOW__WEBSERVER__SECRET_KEY=your-secret-key-here
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://dataops:<mat-khau>@192.168.64.3:5432/dataops_db
AIRFLOW__CELERY__BROKER_URL=redis://192.168.64.3:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://dataops:<mat-khau>@192.168.64.3:5432/dataops_db

# --- THÔNG TIN GIÁM SÁT & WORKER ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<sinh bang: openssl rand -hex 20>

VM3_HOST=192.168.64.4
BACKUP_DIR=/opt/backup
